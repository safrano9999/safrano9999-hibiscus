# Source of truth: SCRIPTS/githubactions. Generated copies are overwritten.
# syntax=docker/dockerfile:1.7

ARG NODE_IMAGE=docker.io/library/node:24-alpine@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1
FROM ${NODE_IMAGE} AS hibiscus-mcp
RUN apk add --no-cache bash git
WORKDIR /src/hibiscus-mcp
COPY build/mcp-source/ ./
RUN npm ci --omit=dev \
 && npm test \
 && HIBISCUS_MCP_NODE=/usr/local/bin/node scripts/setup-supergateway.sh \
 && mkdir -p /opt/hibiscus-mcp \
 && cp server.mjs sync.mjs package.json package-lock.json /opt/hibiscus-mcp/ \
 && cp -a node_modules /opt/hibiscus-mcp/ \
 && mv .runtime/supergateway /opt/supergateway

# Immutable, already deployed 2.12.4 distribution; no dependency on Willuhn uptime.
# Only application files, never a running container's configuration or data volumes.
FROM ghcr.io/safrano9999/safrano9999-hibiscus@sha256:6004750aa84d5ddbe6c46ea6dce87cb01cdc2af347ca8bab0f181e720ae5a3df AS hibiscus-release

FROM fedora45-approved-beta AS runtime-base

COPY --from=hibiscus-release /usr/local/hibiscus /usr/local/hibiscus
ADD --checksum=sha256:bb3bc54587a3ff525d68d1763fae811ba8b2a6d8fc1684e157f3beb9a8c8feec \
    https://repo.maven.apache.org/maven2/com/github/hbci4j/hbci4j-core/4.1.17/hbci4j-core-4.1.17.jar \
    /tmp/hbci4j-core-4.1.17.jar

RUN dnf -y --setopt=install_weak_deps=False install \
      java-25-openjdk-headless nodejs shadow-utils systemd unzip \
 && dnf clean all \
 && useradd --system --home-dir /var/lib/hibiscus --create-home hibiscus \
 && useradd --system --home-dir /var/lib/hibiscus-mcp --create-home hibiscus-mcp \
 && grep -q 'name="hibiscus" version="2.12.4"' /usr/local/hibiscus/plugins/hibiscus/plugin.xml \
 && install -d /usr/share/hibiscus \
 && cp -a /usr/local/hibiscus/cfg /usr/share/hibiscus/cfg \
 && rm -f /usr/local/hibiscus/plugins/hibiscus/lib/hbci4j-core-*.jar \
 && install -m 0644 /tmp/hbci4j-core-4.1.17.jar \
      /usr/local/hibiscus/plugins/hibiscus/lib/hbci4j-core-4.1.17.jar \
 && rm -f /tmp/hbci4j-core-4.1.17.jar

# Recompile two stable 2.12.4 classes, not a nightly plugin. HBCIUtils.init/initThread
# now return HBCI4JavaClient; recompilation updates the JVM method descriptors.
FROM runtime-base AS compatibility
RUN dnf -y --setopt=install_weak_deps=False install java-25-openjdk-devel
ADD --checksum=sha256:05f1667f783cccaf0ae05fb411528debf7a1311b81b4e15a3bad6ee3761f10b2 \
    https://raw.githubusercontent.com/willuhn/hibiscus/2f6108669ad6a9b720d357be1d963af2efd655a9/src/de/willuhn/jameica/hbci/HBCI.java \
    /tmp/HBCI.java
ADD --checksum=sha256:c8d6c299628c149dfcc7c1b15da067c7670c87d03e584aa25ef264d57840340a \
    https://raw.githubusercontent.com/willuhn/hibiscus/2f6108669ad6a9b720d357be1d963af2efd655a9/src/de/willuhn/jameica/hbci/HBCIProperties.java \
    /tmp/HBCIProperties.java
COPY .github/scripts/ApiCompatibility.java /tmp/ApiCompatibility.java
RUN set -eu; \
    classpath="$(find /usr/local/hibiscus -name '*.jar' -printf '%p:' | sed 's/:$//')"; \
    grep -q 'HBCI4JAVA_VERSION = "4.1.10"' /tmp/HBCI.java; \
    sed -i 's/HBCI4JAVA_VERSION = "4.1.10"/HBCI4JAVA_VERSION = "4.1.17"/' /tmp/HBCI.java; \
    javac -encoding ISO-8859-1 -cp "$classpath" -d /tmp/patched /tmp/HBCI.java /tmp/HBCIProperties.java; \
    jar uf /usr/local/hibiscus/plugins/hibiscus/hibiscus.jar -C /tmp/patched .; \
    java -cp "$classpath" /tmp/ApiCompatibility.java /usr/local/hibiscus/plugins

FROM runtime-base
COPY --from=compatibility /usr/local/hibiscus/plugins/hibiscus/hibiscus.jar \
    /usr/local/hibiscus/plugins/hibiscus/hibiscus.jar

COPY --from=hibiscus-mcp --chown=hibiscus-mcp:hibiscus-mcp \
     /opt/hibiscus-mcp /opt/hibiscus-mcp
COPY --from=hibiscus-mcp --chown=hibiscus-mcp:hibiscus-mcp \
     /opt/supergateway /opt/supergateway
COPY systemd/ /usr/lib/systemd/system/

RUN node --check /opt/hibiscus-mcp/server.mjs \
 && systemd-analyze verify safrano9999-hibiscus.service safrano9999-hibiscus-mcp.service safrano9999-hibiscus.target \
 && systemctl enable safrano9999-hibiscus.target

# The distribution stage already carries our existing WebUI charset fix.
RUN grep -q 'setContentType' /usr/local/hibiscus/plugins/hibiscus.server/lib/velocity/includes/header.vm \
 && grep -q 'setContentType' /usr/local/hibiscus/plugins/jameica.webadmin/lib/velocity/includes/header.vm

LABEL org.opencontainers.image.title="safrano9999-hibiscus" \
      org.opencontainers.image.description="Fedora 45, Hibiscus Server 2.12.4 and bearer-aware Hibiscus MCP" \
      org.opencontainers.image.source="https://github.com/safrano9999/safrano9999-hibiscus" \
      io.safrano9999.jameica.version="2.12.0" \
      io.safrano9999.hibiscus.version="2.12.4" \
      io.safrano9999.hbci4java.version="4.1.17" \
      io.safrano9999.hibiscus.distribution.digest="sha256:6004750aa84d5ddbe6c46ea6dce87cb01cdc2af347ca8bab0f181e720ae5a3df" \
      org.opencontainers.image.base.name="Fedora-Container-Base-Generic-45_Beta-1.3.x86_64" \
      org.opencontainers.image.base.digest="sha256:5f6c3c965a3af6b0faa21efc46ab46b9acfb1e1a8f69cec63fd6e44bdcf270cb"

ENV TZ=Europe/Berlin \
    JAVA_TOOL_OPTIONS=-Duser.timezone=Europe/Berlin

VOLUME ["/var/lib/hibiscus/.jameica", "/usr/local/hibiscus/cfg"]
EXPOSE 8000 8080
WORKDIR /usr/local/hibiscus
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
