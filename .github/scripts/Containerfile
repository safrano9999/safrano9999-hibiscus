# Source of truth: SCRIPTS/githubactions. Generated copies are overwritten.
# syntax=docker/dockerfile:1.7

ARG NODE_IMAGE=docker.io/library/node:24-alpine@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1
FROM ${NODE_IMAGE} AS hibiscus-mcp
RUN apk add --no-cache bash git
WORKDIR /src/hibiscus-mcp
COPY build/mcp-source/ ./
RUN npm ci --omit=dev \
 && npm test \
 && HIBISCUS_MCP_NODE=/usr/local/bin/node scripts/setup-supergateway.sh \
 && mkdir -p /opt/hibiscus-mcp \
 && cp server.mjs sync.mjs package.json package-lock.json /opt/hibiscus-mcp/ \
 && cp -a node_modules /opt/hibiscus-mcp/ \
 && mv .runtime/supergateway /opt/supergateway

FROM quay.io/fedora/fedora@sha256:78ebbdc752eda02b9c2705876bd55fe7e5e2fda1a1194fa5e7f1f7486bcc297c

ADD --checksum=sha256:ffe6d7e149f03f2e60915592a35d9872a0660c01338f97167d5eb5866c6ec3bb \
    https://www.willuhn.de/products/hibiscus-server/releases/hibiscus-server-2.12.4.zip \
    /tmp/hibiscus-server.zip
ADD --checksum=sha256:2130fa601ba5cc04a6dd7ac8e6abc32290c338b601b301b120e769ed40ad485d \
    https://repo.maven.apache.org/maven2/com/github/hbci4j/hbci4j-core/4.1.13/hbci4j-core-4.1.13.jar \
    /tmp/hbci4j-core-4.1.13.jar

RUN dnf -y --setopt=install_weak_deps=False install \
      java-25-openjdk-headless nodejs shadow-utils systemd unzip \
 && dnf clean all \
 && useradd --system --home-dir /var/lib/hibiscus --create-home hibiscus \
 && useradd --system --home-dir /var/lib/hibiscus-mcp --create-home hibiscus-mcp \
 && unzip -q /tmp/hibiscus-server.zip -d /usr/local \
 && mv /usr/local/hibiscus-server /usr/local/hibiscus \
 && install -d /usr/share/hibiscus \
 && cp -a /usr/local/hibiscus/cfg /usr/share/hibiscus/cfg \
 && rm -f /usr/local/hibiscus/plugins/hibiscus/lib/hbci4j-core-*.jar \
 && install -m 0644 /tmp/hbci4j-core-4.1.13.jar \
      /usr/local/hibiscus/plugins/hibiscus/lib/hbci4j-core-4.1.13.jar \
 && rm -f /tmp/hibiscus-server.zip /tmp/hbci4j-core-4.1.13.jar

COPY --from=hibiscus-mcp --chown=hibiscus-mcp:hibiscus-mcp \
     /opt/hibiscus-mcp /opt/hibiscus-mcp
COPY --from=hibiscus-mcp --chown=hibiscus-mcp:hibiscus-mcp \
     /opt/supergateway /opt/supergateway
COPY systemd/ /usr/lib/systemd/system/

RUN node --check /opt/hibiscus-mcp/server.mjs \
 && systemd-analyze verify safrano9999-hibiscus.service safrano9999-hibiscus-mcp.service safrano9999-hibiscus.target \
 && systemctl enable safrano9999-hibiscus.target

RUN sed -i '2i#set($charsetHeader = $response.setContentType("text/html; charset=ISO-8859-1"))' \
    /usr/local/hibiscus/plugins/hibiscus.server/lib/velocity/includes/header.vm \
    /usr/local/hibiscus/plugins/jameica.webadmin/lib/velocity/includes/header.vm

LABEL org.opencontainers.image.title="safrano9999-hibiscus" \
      org.opencontainers.image.description="Fedora 45, Hibiscus Server 2.12.4 and bearer-aware Hibiscus MCP" \
      org.opencontainers.image.source="https://github.com/safrano9999/safrano9999-hibiscus" \
      io.safrano9999.jameica.version="2.12.0" \
      io.safrano9999.hibiscus.version="2.12.4" \
      io.safrano9999.hbci4java.version="4.1.13"

ENV TZ=Europe/Berlin \
    JAVA_TOOL_OPTIONS=-Duser.timezone=Europe/Berlin

VOLUME ["/var/lib/hibiscus/.jameica", "/usr/local/hibiscus/cfg"]
EXPOSE 8000 8080
WORKDIR /usr/local/hibiscus
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
